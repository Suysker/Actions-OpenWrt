# Shared package, toolchain and network contract for every maintained profile.
# Target, image layout, CPU flags and hardware-only packages belong to devices.

# Default for local/automated resolution. Manual Actions builds override this from
# their stable/testing selector, and the source lock preserves the exact choice.
CONFIG_TESTING_KERNEL=y
# CONFIG_KERNEL_MPTCP is not set
# CONFIG_KERNEL_MPTCP_IPV6 is not set

# Build/toolchain policy: native Lean GCC 15, reproducible reports and OPKG.
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_INCLUDE_CONFIG=y
CONFIG_REPRODUCIBLE_DEBUG_INFO=y
# CONFIG_USE_APK is not set
# CONFIG_USE_GC_SECTIONS is not set
# CONFIG_USE_LTO is not set
# CONFIG_USE_MOLD is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set

# Shared firewall3/iptables router stack.
# CONFIG_PACKAGE_dnsmasq is not set

# Shared proxy feature policy.
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Mihomo is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy is not set

# Shared package feature policy.
# CONFIG_HTOP_LMSENSORS is not set
