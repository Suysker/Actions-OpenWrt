{
  "schema": 3,
  "source": [
    {
      "name": "common.turboacc-flow-detection",
      "path": "feeds/luci/applications/luci-app-turboacc/root/etc/uci-defaults/turboacc",
      "contains": [
        "/lib/modules/$kernel_ver/xt_FLOWOFFLOAD.ko",
        "turboacc.config.fastpath\"=\"flow_offloading",
        "turboacc.config.fastpath_fo_hw\"=\"0",
        "/etc/init.d/turboacc enable",
        "/etc/init.d/turboacc start"
      ]
    },
    {
      "name": "common.turboacc-software-flow-runtime",
      "path": "feeds/luci/applications/luci-app-turboacc/root/etc/init.d/turboacc",
      "contains": [
        "\"flow_offloading\")",
        "flow_offloading=\"1\"",
        "uci -q set \"firewall.@defaults[0].flow_offloading\"=\"$flow_offloading\"",
        "uci -q set \"firewall.@defaults[0].flow_offloading_hw\"=\"$flow_offloading_hw\"",
        "sysctl -w net.ipv4.tcp_congestion_control=\"$tcpcca\""
      ]
    },
    {
      "name": "common.ppp-tx-scatter-gather",
      "glob": "build_dir/target-*/linux-*/linux-{kernel_version}/drivers/net/ppp/ppp_generic.c",
      "contains": [
        "dev->features = NETIF_F_SG | NETIF_F_FRAGLIST;",
        "dev->hw_features = dev->features;",
        "!chan->direct_xmit && skb_linearize(skb)"
      ]
    },
    {
      "name": "common.pppoe-gro-gso-ipv4-ipv6",
      "glob": "build_dir/target-*/linux-*/linux-{kernel_version}/drivers/net/ppp/pppoe.c",
      "contains": [
        "case cpu_to_be16(PPP_IP):",
        "case cpu_to_be16(PPP_IPV6):",
        ".gro_receive = pppoe_gro_receive,",
        ".gro_complete = pppoe_gro_complete,",
        ".gso_segment = pppoe_gso_segment,",
        "dev_add_offload(&pppoe_packet_offload);"
      ]
    }
  ]
}
