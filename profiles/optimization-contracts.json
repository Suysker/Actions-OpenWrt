{
  "schema": 1,
  "scopes": {
    "common": {
      "rootfs": [
        {
          "name": "common.bbr3-fq-turboacc-default",
          "path": "etc/uci-defaults/zz-common-turboacc",
          "contains": [
            "/sys/module/tcp_bbr/version",
            "[ \"$(cat /sys/module/tcp_bbr/version)\" = \"3\" ]",
            "[ -d /sys/module/sch_fq ]",
            "grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control",
            "[ \"$(uci -q get turboacc.config.fastpath || true)\" = \"flow_offloading\" ]",
            "[ \"$(uci -q get turboacc.config.fastpath_fo_hw || true)\" = \"0\" ]",
            "set turboacc.config.tcpcca='bbr'",
            "[ \"$(cat /proc/sys/net/ipv4/tcp_congestion_control)\" = \"bbr\" ]",
            "set turboacc.global.project_factory_applied='1'"
          ]
        },
        {
          "name": "common.fq-and-socket-buffers",
          "path": "etc/sysctl.d/90-router-performance.conf",
          "line_set": [
            "net.core.default_qdisc=fq",
            "net.core.rmem_max=16777216",
            "net.core.wmem_max=16777216"
          ]
        }
      ],
      "source": [
        {
          "name": "common.turboacc-flow-detection",
          "path": "feeds/luci/applications/luci-app-turboacc/root/etc/uci-defaults/turboacc",
          "contains": [
            "/lib/modules/$kernel_ver/xt_FLOWOFFLOAD.ko",
            "turboacc.config.fastpath\"=\"flow_offloading",
            "turboacc.config.fastpath_fo_hw\"=\"0",
            "/etc/init.d/turboacc enable",
            "/etc/init.d/turboacc start"
          ]
        },
        {
          "name": "common.turboacc-software-flow-runtime",
          "path": "feeds/luci/applications/luci-app-turboacc/root/etc/init.d/turboacc",
          "contains": [
            "\"flow_offloading\")",
            "flow_offloading=\"1\"",
            "uci -q set \"firewall.@defaults[0].flow_offloading\"=\"$flow_offloading\"",
            "uci -q set \"firewall.@defaults[0].flow_offloading_hw\"=\"$flow_offloading_hw\"",
            "sysctl -w net.ipv4.tcp_congestion_control=\"$tcpcca\""
          ]
        }
      ]
    },
    "r4s": {
      "rootfs": [
        {
          "name": "r4s.zram-and-packet-steering",
          "path": "etc/uci-defaults/91-r4s-performance",
          "contains": [
            "set system.@system[0].zram_size_mb='512'",
            "set system.@system[0].zram_comp_algo='lz4'",
            "set network.globals.packet_steering='1'"
          ]
        },
        {
          "name": "r4s.low-zram-swappiness",
          "path": "etc/sysctl.d/91-r4s-memory.conf",
          "line_set": [
            "vm.swappiness=5"
          ]
        }
      ],
      "source": [
        {
          "name": "r4s.irq-affinity",
          "path": "target/linux/rockchip/armv8/base-files/etc/hotplug.d/net/40-net-smp-affinity",
          "contains": [
            "friendlyarm,nanopi-r4s",
            "set_interface_core 10 \"eth0\"",
            "set_interface_core 20 \"eth1\""
          ]
        },
        {
          "name": "r4s.native-interface-map",
          "path": "target/linux/rockchip/armv8/base-files/etc/board.d/02_network",
          "contains": [
            "friendlyarm,nanopi-r4s",
            "ucidef_set_interfaces_lan_wan 'eth1' 'eth0'"
          ]
        },
        {
          "name": "r4s.schedutil-governor",
          "path": "target/linux/rockchip/armv8/config-{kernel_series}",
          "exact_lines": [
            "CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y",
            "CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y"
          ]
        },
        {
          "name": "r4s.arm64-crypto-crc",
          "path": "target/linux/rockchip/armv8/config-{kernel_series}",
          "exact_lines": [
            "CONFIG_CRYPTO_AES_ARM64_CE=y",
            "CONFIG_CRYPTO_GHASH_ARM64_CE=y",
            "CONFIG_CRYPTO_CRC32=y",
            "CONFIG_CRYPTO_CRC32C=y"
          ]
        },
        {
          "name": "r4s.rk3399-opp",
          "glob": "target/linux/rockchip/patches-{kernel_series}/*.patch",
          "contains": [
            "rk3399-opp.dtsi",
            "opp-hz = /bits/ 64 <1800000000>;",
            "opp-hz = /bits/ 64 <2208000000>;",
            "#include \"rk3399-opp.dtsi\""
          ]
        }
      ]
    },
    "x86-n5105-pve": {
      "rootfs": [
        {
          "name": "x86-n5105-pve.driver-owned-four-queues",
          "path": "etc/uci-defaults/91-x86-n5105-performance",
          "contains": [
            "ethtool -i \"$1\"",
            "[ \"$count\" = \"1\" ]",
            "lan_interface=\"$(require_single_interface virtio_net)\"",
            "wan_interface=\"$(require_single_interface igc)\"",
            "ethtool -L \"$interface\" combined 4",
            "[ \"$(current_combined_channels \"$interface\")\" = \"4\" ]",
            "network.$lan_device_section.ports=$lan_interface",
            "network.wan.device=$wan_interface",
            "network.wan6.device=$wan_interface",
            "set network.globals.packet_steering='0'"
          ]
        },
        {
          "name": "x86-n5105-pve.hotplug-four-queues",
          "path": "etc/hotplug.d/net/91-n5105-multiqueue",
          "contains": [
            "virtio_net|igc)",
            "ethtool -L \"$interface\" combined 4"
          ]
        }
      ],
      "source": [
        {
          "name": "x86-n5105-pve.virtio-built-in",
          "path": "target/linux/x86/64/config-{kernel_series}",
          "exact_lines": [
            "CONFIG_VIRTIO_NET=y",
            "CONFIG_SCSI_VIRTIO=y"
          ]
        },
        {
          "name": "x86-n5105-pve.i225-eee-disabled",
          "glob": "target/linux/x86/patches-{kernel_series}/*.patch",
          "contains": [
            "igc_set_eee_i225(hw, false, false, false);"
          ]
        },
        {
          "name": "x86-n5105-pve.igc-vlan-offload",
          "glob": "target/linux/generic/backport-{kernel_series}/*.patch",
          "contains": [
            "netdev->features |= NETIF_F_HW_VLAN_CTAG_TX | NETIF_F_HW_VLAN_CTAG_RX;"
          ]
        }
      ]
    }
  }
}
