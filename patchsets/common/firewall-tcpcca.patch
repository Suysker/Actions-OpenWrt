diff --git a/package/network/config/firewall/files/firewall.config b/package/network/config/firewall/files/firewall.config
--- a/package/network/config/firewall/files/firewall.config
+++ b/package/network/config/firewall/files/firewall.config
@@ -3,6 +3,9 @@ config defaults
 	option input		ACCEPT
 	option output		ACCEPT
 	option forward		REJECT
-	option fullcone		0
+	option fullcone		1
+	option flow_offloading	1
+	option flow_offloading_hw	0
+	option tcpcca		bbr
 # Uncomment this line to disable ipv6 rules
 #	option disable_ipv6	1
diff --git a/package/network/config/firewall/files/firewall.init b/package/network/config/firewall/files/firewall.init
--- a/package/network/config/firewall/files/firewall.init
+++ b/package/network/config/firewall/files/firewall.init
@@ -52,28 +52,45 @@ service_triggers() {
+apply_tcpcca() {
+	local tcpcca
+	tcpcca="$(uci -q get 'firewall.@defaults[0].tcpcca')" || return 0
+	[ -n "$tcpcca" ] || return 0
+
+	if [ "$tcpcca" = bbr ] && [ "$(cat /sys/module/tcp_bbr/version)" != 3 ]; then
+		echo 'firewall: refusing bbr because the loaded tcp_bbr is not version 3' >&2
+		return 1
+	fi
+	sysctl -qw "net.ipv4.tcp_congestion_control=$tcpcca"
+}
+
+run_fw3() {
+	local operation="$1" status=0
+	shift
+	set_lock || return
+	if [ "$operation" = reload ]; then
+		reload_config firewall
+	fi
+	fw3 "$@" "$operation" && apply_tcpcca || status=$?
+	unset_lock
+	return "$status"
+}
+
 restart() {
 	unset_lock
-	set_lock
-	fw3 restart
-	unset_lock
+	run_fw3 restart
 }
 
 start_service() {
-	set_lock
-	fw3 ${QUIET} start
-	unset_lock
+	run_fw3 start ${QUIET}
 }
 
 stop_service() {
 	fw3 flush
 	unset_lock
 }
 
 reload_service() {
-  unset_lock
-  set_lock
-	reload_config firewall
-	fw3 reload
-	unset_lock
+	unset_lock
+	run_fw3 reload
 }
 
