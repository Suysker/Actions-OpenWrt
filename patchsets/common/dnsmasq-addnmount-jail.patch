diff --git a/package/network/services/dnsmasq/files/dnsmasq.init b/package/network/services/dnsmasq/files/dnsmasq.init
--- a/package/network/services/dnsmasq/files/dnsmasq.init
+++ b/package/network/services/dnsmasq/files/dnsmasq.init
@@ -200,6 +200,11 @@ append_addnhosts() {
 	xappend "--addn-hosts=$1"
 }
 
+append_addnmount() {
+	[ -e "$1" ] || return 0
+	ismounted "$1" || append EXTRA_MOUNT "$1"
+}
+
 append_bogusnxdomain() {
 	xappend "--bogus-nxdomain=$1"
 }
@@ -926,6 +930,7 @@ dnsmasq_start()
 		xappend "--addn-hosts=$HOSTFILE_DIR"
 		append EXTRA_MOUNT "$HOSTFILE_DIR"
 	fi
 	config_list_foreach "$cfg" "addnhosts" append_addnhosts
+	config_list_foreach "$cfg" "addnmount" append_addnmount
 	config_list_foreach "$cfg" "bogusnxdomain" append_bogusnxdomain
 	append_parm "$cfg" "leasefile" "--dhcp-leasefile" "/tmp/dhcp.leases"
 	append_parm "$cfg" "serversfile" "--servers-file"
